{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buccl.dev/harness/execution-envelope.schema.json",
  "title": "Parent-owned execution envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "engine", "provider", "run_id", "started_at", "finished_at", "exit_code", "timed_out", "fresh_process", "session_resumed", "isolation_mode", "source_snapshot_before", "source_snapshot_after", "packet_id", "evidence_bundle_id", "repository_mutated", "result_sha256", "status", "error_code"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "stage": {"enum": ["evaluate", "review"]},
    "engine": {"enum": ["claude", "codex"]},
    "provider": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "fresh_process": {"type": "boolean"},
    "session_resumed": {"type": "boolean"},
    "isolation_mode": {"enum": ["macos-sandbox-exec", "container-read-only", "unsupported", "best-effort"]},
    "source_snapshot_before": {"type": "string", "minLength": 1},
    "source_snapshot_after": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "evidence_bundle_id": {"type": "string", "minLength": 1},
    "repository_mutated": {"type": "boolean"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "error_code": {"type": ["string", "null"]}
  }
}
