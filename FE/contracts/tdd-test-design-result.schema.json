{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buccl.dev/harness/tdd-test-design-result.schema.json",
  "title": "TDD Test Design Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "tier", "status", "test_id", "acceptance_refs", "red_failure_kind", "assertions", "mocked_boundaries", "system_under_test_mocked", "paths", "reviewer"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "stage": {"const": "tdd-test-design"},
    "tier": {"enum": ["T0", "T1", "T2"]},
    "status": {"enum": ["PASS", "BLOCKED", "NEEDS_HUMAN_REVIEW"]},
    "test_id": {"type": "string", "minLength": 1},
    "acceptance_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "red_failure_kind": {"enum": ["missing_behavior", "bug_reproduced"]},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "description"], "properties": {"kind": {"enum": ["observable_behavior", "state", "side_effect", "error_contract"]}, "description": {"type": "string", "minLength": 1}}}},
    "mocked_boundaries": {"type": "array", "items": {"type": "string"}},
    "system_under_test_mocked": {"const": false},
    "paths": {"type": "array", "items": {"enum": ["success", "failure", "boundary"]}},
    "reviewer": {"type": "object", "required": ["independent", "read_only"], "properties": {"independent": {"type": "boolean"}, "read_only": {"const": true}}}
  }
}
