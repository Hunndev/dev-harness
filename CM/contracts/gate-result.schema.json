{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buccl.dev/harness/gate-result.schema.json",
  "title": "Deterministic Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "status", "source_snapshot_id", "commands", "tdd_evidence"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "stage": {"const": "gate"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "source_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "command", "exit_code", "duration_ms", "stdout_tail", "stderr_tail", "stdout_sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "stdout_tail": {"type": "string"},
          "stderr_tail": {"type": "string"},
          "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "tdd_evidence": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
