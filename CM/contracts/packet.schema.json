{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buccl.dev/harness/packet.schema.json",
  "title": "Content-bound Evaluate/Review packet",
  "type": "object",
  "required": [
    "packet_id",
    "source_snapshot_id",
    "evidence_bundle_id",
    "request",
    "evidence_entries"
  ],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "required": ["text", "acceptance_refs", "prompt_sha256", "model_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "acceptance_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "prompt_sha256": {
          "type": "object",
          "required": ["evaluate", "review"],
          "properties": {
            "evaluate": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "review": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "model_ids": {
          "type": "object",
          "required": ["claude", "codex"],
          "properties": {
            "claude": {"type": "string", "minLength": 1},
            "codex": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "evidence_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
